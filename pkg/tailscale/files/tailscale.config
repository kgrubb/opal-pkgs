config settings 'settings'
	option log_stderr '1'
	option log_stdout '1'
	option port '41641'
	option state_file '/etc/tailscale/tailscaled.state'
	# fw4 on firmware 4.8. set to iptables if this build still has the legacy tables.
	option fw_mode 'nftables'

# tailscale up
# subnet router: tailscale up --advertise-routes=192.168.8.0/24
